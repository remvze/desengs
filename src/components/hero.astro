---
import { Container } from './container';
import Lines from './lines.astro';
import { Logo } from './logo';
import { ShinyText } from './shiny-text';
import { Link } from './link';
import { Sponsors } from './sponsors';
---

<div class="hidden">
  <Container>
    <section class="hero">
      <Lines />
      <Logo client:load />
      <h1>
        The <i><ShinyText text="Ultimate" /></i> Resource<br />
        <span>for</span> Design
        <i>Engineers.</i>
      </h1>
      <p class="desc">
        Curated by design engineers;
        <br /><span>—</span> for design engineers.
      </p>

      <Sponsors client:only="react">
        <div class="cover" slot="fallback"></div>
      </Sponsors>

      <div class="links">
        <Link text="Inspiration" url="/inspiration" />
        <Link text="DSGNRS" url="/dsgnrs" />
        <Link blank text="Minimum" url="https://mnmm.xyz" />
        <Link
          blank
          text="Newsletter"
          url="https://curationsystems.substack.com"
        />
      </div>
    </section>
  </Container>
</div>

<style>
  .hidden {
    position: relative;
    overflow: hidden;
  }

  .hero {
    padding: 150px 0 50px;

    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
      line-height: 1.2;
      color: var(--color-foreground);

      & span {
        font-size: var(--font-lg);
      }

      & i {
        font-style: italic;
      }
    }

    & .desc {
      margin-top: 24px;
      line-height: 1.5;
      color: var(--color-foreground-subtle);

      & span {
        color: var(--color-foreground-subtler);
      }
    }

    & .links {
      display: flex;
      gap: 8px;
      margin-top: 28px;
    }
  }

  .cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-neutral-50);
  }
</style>
