---
import { Container } from './container';
import Lines from './lines.astro';
import { Logo } from './logo';
import { ShinyText } from './shiny-text';
import { Link } from './link';
import { Sponsors } from './sponsors';
---

<div class="hidden">
  <Container>
    <section class="hero">
      <Lines />
      <Logo client:load />
      <h1>
        The <i><ShinyText text="Ultimate" /></i> Resource<br />
        <span>for</span> Design
        <i>Engineers.</i>
      </h1>
      <p class="desc">
        Curated by design engineers;
        <br /><span>—</span> for design engineers.
      </p>

      <Sponsors client:only="react">
        <div class="sponsors-loader" slot="fallback">
          <div class="loader"></div>
          <p>Loading Sponsors...</p>
        </div>
      </Sponsors>

      <div class="links">
        <Link text="Talent Network" url="/talent-network" />
        <Link
          blank
          text="Source Code"
          url="https://github.com/remvze/desengs"
        />
      </div>
    </section>
  </Container>
</div>

<style>
  .hidden {
    position: relative;
    overflow: hidden;
  }

  .hero {
    padding: 150px 0 50px;

    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
      line-height: 1.2;
      color: var(--color-foreground);

      & span {
        font-size: var(--font-lg);
      }

      & i {
        font-style: italic;
      }
    }

    & .desc {
      margin-top: 24px;
      line-height: 1.5;
      color: var(--color-foreground-subtle);

      & span {
        color: var(--color-foreground-subtler);
      }
    }

    & .links {
      display: flex;
      gap: 8px;
      margin-top: 28px;
    }
  }

  .sponsors-loader {
    display: flex;
    gap: 4px;
    align-items: center;
    margin-top: 28px;

    & .loader {
      width: 10px;
      height: 10px;
      border: 2px solid var(--color-neutral-100);
      border-top-color: var(--color-neutral-600);
      border-radius: 50%;
      animation-name: loader;
      animation-duration: 0.5s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    & p {
      font-size: var(--font-xsm);
      color: var(--color-foreground-subtler);
    }
  }

  @keyframes loader {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
