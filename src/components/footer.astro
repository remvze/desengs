---
import { Container } from './container';
import Spacer from './spacer.astro';
import { SponsorCarousel } from './sponsors/carousel';
---

<footer class="footer">
  <Container>
    <Spacer />
    <p class="curator">
      <span>—</span> Curated by <a href="https://x.com/remvze">Maze Heart</a>
    </p>
  </Container>
  <SponsorCarousel client:load />
</footer>

<style>
  .footer {
    padding-bottom: calc(150px + env(safe-area-inset-bottom));

    & .curator {
      padding-top: 24px;
      font-family: var(--font-mono);
      font-size: var(--font-2xsm);
      font-weight: 500;
      color: var(--color-foreground-subtler);
      text-transform: uppercase;

      & span {
        color: var(--color-foreground);
      }

      & a {
        color: var(--color-foreground-subtle);
        text-decoration: none;
        transition: 0.2s;

        &:hover {
          color: var(--color-foreground);
        }
      }
    }
  }
</style>
