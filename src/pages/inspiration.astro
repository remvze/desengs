---
import { IoIosArrowRoundBack } from 'react-icons/io';

import Layout from '@/layouts/layout.astro';
import { ShinyText } from '@/components/shiny-text';
import { Container } from '@/components/container';
import { Websites } from '@/components/websites';
import { websites } from '@/data/websites';
import { Sponsors } from '@/components/sponsors';
import { Link } from '@/components/link';
---

<Layout title="Web Design Inspiration">
  <Container>
    <section class="hero">
      <a href="/"><IoIosArrowRoundBack /></a>
      <h1>
        The <i>Daily</i> Web<br />Design <i><ShinyText text="Inspiration" />.</i
        >
      </h1>
      <p>
        <span>{websites.length.toString().padStart(3, '0')}</span> well-designed
        websites.
      </p>

      <Sponsors client:only="react">
        <div class="cover" slot="fallback"></div>
      </Sponsors>

      <div class="links">
        <Link text="Serendipity" url="/inspiration/serendipity" />
        <Link text="OG Images" url="/inspiration/og" />
      </div>
    </section>
  </Container>

  <Websites client:load />
</Layout>

<style>
  .hero {
    padding: 120px 0 60px;

    & a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      margin-bottom: 32px;
      color: var(--color-foreground);
      text-decoration: none;
      background: var(--color-neutral-100);
      border-radius: 50%;
    }

    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
      line-height: 1.2;

      & i {
        font-style: italic;
      }
    }

    p {
      margin-top: 20px;
      color: var(--color-foreground-subtle);

      & span {
        font-family: var(--font-mono);
        color: var(--color-foreground);
      }
    }

    & .links {
      display: flex;
      gap: 8px;
      margin-top: 28px;
    }
  }

  .cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-neutral-50);
  }
</style>
