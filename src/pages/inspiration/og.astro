---
import { IoIosArrowRoundBack } from 'react-icons/io';

import Layout from '@/layouts/layout.astro';
import { ShinyText } from '@/components/shiny-text';
import { Container } from '@/components/container';
import { Images } from '@/components/images';
import { images } from '@/data/images';
import { Sponsors } from '@/components/sponsors';
import Breadcrumbs from '@/components/breadcrumbs.astro';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: images.map((image, index) => ({
        '@type': 'ListItem',
        name: `${image.source.name} Open Graph image`,
        position: index + 1,
        url: new URL(`/inspiration/og/${image.slug}`, Astro.site).toString(),
      })),
      numberOfItems: images.length,
    },
    name: 'Open Graph Image Design Inspiration',
    url: new URL('/inspiration/og/', Astro.site).toString(),
  },
];
---

<Layout
  description={`Explore ${images.length} curated Open Graph image designs for inspiration when creating social sharing previews.`}
  schemas={schemas}
  title="Open Graph Image Design Inspiration"
>
  <Container>
    <section class="hero">
      <a href="/inspiration"><IoIosArrowRoundBack /></a>
      <Breadcrumbs
        items={[
          { label: 'Home', url: '/' },
          { label: 'Inspiration', url: '/inspiration' },
          { label: 'OG Images' },
        ]}
      />
      <h1>
        Gallery of <i><ShinyText text="Beautiful" /></i><br />OG <i>Images.</i>
      </h1>
      <p>
        <span>{images.length.toString().padStart(3, '0')}</span> well-designed OG
        images.
      </p>

      <Sponsors client:only="react">
        <div class="cover" slot="fallback"></div>
      </Sponsors>
    </section>
  </Container>

  <Container wide>
    <Images client:load />
  </Container>
</Layout>

<style>
  .hero {
    padding: 120px 0 60px;

    & a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      margin-bottom: 32px;
      color: var(--color-foreground);
      text-decoration: none;
      background: var(--color-neutral-100);
      border-radius: 50%;
    }

    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
      line-height: 1.2;

      & i {
        font-style: italic;
      }
    }

    p {
      margin-top: 20px;
      color: var(--color-foreground-subtle);

      & span {
        font-family: var(--font-mono);
        color: var(--color-foreground);
      }
    }
  }

  .cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-neutral-50);
  }
</style>
