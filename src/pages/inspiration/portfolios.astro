---
import { IoIosArrowRoundBack } from 'react-icons/io';

import Breadcrumbs from '@/components/breadcrumbs.astro';
import { Container } from '@/components/container';
import { Portfolios } from '@/components/portfolios';
import { Sponsors } from '@/components/sponsors';
import { portfolios } from '@/data/portfolios';
import { ShinyText } from '@/components/shiny-text';
import Layout from '@/layouts/layout.astro';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: portfolios.map((portfolio, index) => ({
        '@type': 'ListItem',
        name: portfolio.name,
        position: index + 1,
        url: new URL(
          `/inspiration/portfolios/${portfolio.slug}`,
          Astro.site,
        ).toString(),
      })),
      numberOfItems: portfolios.length,
    },
    name: 'Curated Portfolio Design Inspiration',
    url: new URL('/inspiration/portfolios/', Astro.site).toString(),
  },
];
---

<Layout
  description={`Explore ${portfolios.length} curated individual and collective portfolios showcasing exceptional design and creative development.`}
  schemas={schemas}
  title="Curated Portfolio Design Inspiration"
>
  <Container>
    <section class="hero">
      <a aria-label="Back to inspiration" href="/inspiration">
        <IoIosArrowRoundBack />
      </a>
      <Breadcrumbs
        items={[
          { label: 'Home', url: '/' },
          { label: 'Inspiration', url: '/inspiration' },
          { label: 'Portfolios' },
        ]}
      />
      <h1>
        Archive of <i><ShinyText text="Exceptional" /></i><br /><i>Portfolio</i>
        Websites.
      </h1>
      <p>
        <span>{portfolios.length.toString().padStart(3, '0')}</span> well-designed
        portfolios.
      </p>

      <Sponsors client:only="react">
        <div class="cover" slot="fallback"></div>
      </Sponsors>
    </section>
  </Container>

  <Portfolios />
</Layout>

<style>
  .hero {
    padding: 120px 0 60px;

    & a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      margin-bottom: 32px;
      color: var(--color-foreground);
      text-decoration: none;
      background: var(--color-neutral-100);
      border-radius: 50%;
    }

    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
      line-height: 1.2;

      & i {
        font-style: italic;
      }
    }

    & p {
      margin-top: 20px;
      color: var(--color-foreground-subtle);

      & span {
        font-family: var(--font-mono);
        color: var(--color-foreground);
      }
    }
  }

  .cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-neutral-50);
  }
</style>
