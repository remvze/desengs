---
import { IoIosArrowRoundBack, IoIosArrowRoundForward } from 'react-icons/io';

import { Container } from '@/components/container';
import { images } from '@/data/images';
import { formatDate } from '@/helpers/date';
import { pickMany } from '@/helpers/random';
import Layout from '@/layouts/layout.astro';

type Image = (typeof images)[number];

export function getStaticPaths() {
  return images.map(image => ({
    params: { slug: image.slug },
    props: { image },
  }));
}

interface Props {
  image: Image;
}

const { image } = Astro.props;
const relatedImages = pickMany(
  images.filter(item => item.slug !== image.slug),
  3,
);
---

<Layout
  description={`OG image inspiration from ${image.source.name}.`}
  og={image.image}
  title={`${image.source.name} // OG Image Inspiration`}
>
  <Container>
    <main>
      <header class="header">
        <a
          aria-label="Back to OG image inspiration"
          class="back"
          href="/inspiration/og"
        >
          <IoIosArrowRoundBack />
        </a>
        <div class="title">
          <h1>{image.source.name}</h1>
          <a href={image.source.url} rel="noreferrer" target="_blank">
            {image.source.address}<IoIosArrowRoundForward />
          </a>
        </div>
      </header>

      <a
        class="screenshot"
        href={image.source.url}
        rel="noreferrer"
        target="_blank"
      >
        <img
          alt={`OG for ${image.source.name}`}
          src={image.image}
          style={{
            aspectRatio: `${image.dimensions.width} / ${image.dimensions.height}`,
          }}
        />
      </a>

      <section class="info">
        <p>Added on {formatDate(new Date(image.date))}</p>
      </section>

      <section class="related">
        <h2>More inspiration</h2>
        <div class="websites">
          {
            relatedImages.map(item => (
              <article class="website">
                <a href={`/inspiration/og/${item.slug}`}>
                  <img
                    alt={`OG for ${item.source.name}`}
                    loading="lazy"
                    src={item.image}
                    style={`aspect-ratio: ${item.dimensions.width} / ${item.dimensions.height}`}
                  />
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </Container>
</Layout>

<style>
  main {
    padding: 80px 0;
  }

  .header {
    margin-bottom: 24px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-bottom: 32px;
    color: var(--color-foreground);
    text-decoration: none;
    background: var(--color-neutral-100);
    border-radius: 50%;
  }

  .title {
    & h1 {
      font-family: var(--font-display);
      font-size: var(--font-2xlg);
    }

    & a {
      display: inline-flex;
      gap: 2px;
      align-items: center;
      margin-top: 4px;
      font-family: var(--font-mono);
      font-size: var(--font-2xsm);
      color: var(--color-foreground-subtle);
      text-decoration: none;
      text-transform: uppercase;
    }
  }

  .screenshot {
    display: block;

    & img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--color-neutral-300);
    }
  }

  .info {
    display: flex;
    justify-content: end;
    margin-top: 8px;
    font-size: var(--font-xsm);
    color: var(--color-foreground-subtler);
  }

  .related {
    padding-top: 80px;

    & h2 {
      margin-bottom: 24px;
      font-family: var(--font-display);
      font-size: var(--font-lg);
    }

    & .websites {
      display: flex;
      flex-direction: column;
      gap: 12px;

      .website {
        & img {
          display: block;
          width: 100%;
          border: 1px solid var(--color-neutral-300);
          transition: transform 0.2s;

          &:hover {
            transform: scale(1.025);
          }
        }
      }
    }
  }
</style>
