---
import { SerendipityCanvas } from '@/components/serendipity';
import { websites } from '@/data/websites';
import Layout from '@/layouts/layout.astro';
---

<Layout
  description={`Explore a randomized infinite canvas of ${websites.length} curated websites and discover unexpected web design inspiration.`}
  title="Serendipity: Random Web Design Inspiration"
>
  <SerendipityCanvas client:load websites={websites} />
</Layout>
